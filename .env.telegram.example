# Copy to .env in the project root. Never commit the completed file.
# Local prototype defaults. For Telegram set these to your actual HTTPS hostname.
APP_HOST=localhost
APP_ORIGIN=http://localhost:8080
WEB_PORT=8080

# Required only when connecting a real bot. Do not put this in VITE_* variables.
TELEGRAM_BOT_TOKEN=
TELEGRAM_MINI_APP_URL=
# Private pilot: replace with your and your partner's numeric Telegram user IDs.
# Leaving this placeholder makes Telegram login fail closed until configured.
TELEGRAM_ALLOWED_IDS=YOUR_ID,PARTNER_ID

# No public registration for the private pilot. Allowed Telegram IDs may register.
INVITE_ONLY=1
ALLOW_GUEST=0
PASSWORD_LOGIN=0
FIRST_USER_ADMIN=0

# Fill only for the optional HTTPS Caddy profile.
ACME_EMAIL=

# AI Coach through OpenRouter (docs/telegram/COACH.md). Off unless COACH_DISABLED=0.
# The key lives only here (the server's .env), never in the database, the repository or the app.
# Create one at openrouter.ai/keys, paste it after the = sign, keep this file out of git and backups.
COACH_DISABLED=1
OPENROUTER_API_KEY=
# Empty means the default free model from docs/telegram/COACH.md.
OPENROUTER_MODEL=
# Tried once when the first model is out of quota or unavailable. Empty = none (a paid model goes here).
OPENROUTER_FALLBACK_MODEL=
# 1 (default) = only :free models or openrouter/free are accepted for the model and the fallback.
OPENROUTER_ONLY_FREE=1
# 1 = route only to providers that do not log or train on prompts. Free models mostly have none.
COACH_OPENROUTER_NO_TRAINING=0
# Ceilings the admin card cannot raise: runs per person per day, runs for everyone per day.
COACH_PER_USER_DAILY_MAX=5
COACH_INSTANCE_DAILY_MAX=20
